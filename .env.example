# Nova OS Bridge Environment Variables (Placeholders only)

# Groq Cloud API Key for intent extraction and task classification
GROQ_API_KEY=your_groq_api_key_here

# AssemblyAI API Key for live browser/phone voice streaming token generation
ASSEMBLYAI_API_KEY=your_assemblyai_api_key_here

# Utility Backend Base URL for document and file conversions
UTILITY_BACKEND_URL=https://goori-os-backend-endpoints.onrender.com

# Allowed Cross-Origin domains (comma-separated) for CORS preflight and voice tokens
ALLOWED_ORIGINS=https://gorios-frontend.vercel.app,https://gori-os.onrender.com,http://localhost:7890

# WebSocket Port (local default: 7891; on Render set to match $PORT)
PORT_WS=7891
